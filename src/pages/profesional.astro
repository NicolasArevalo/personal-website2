---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Profesional" description="Mi portafolio profesional y experiencia laboral.">
  <div class="container page-content">
    <header class="page-header">
      <h1>Profesional</h1>
      <p class="subtitle">Mi experiencia y los proyectos en los que he trabajado.</p>
    </header>

    <div class="prose">
      <h2>Titulaciones y Educación</h2>
      
      <div class="badges-container">
        <a href="https://niiico.com/_astro/inge.64d8bbb7.pdf" target="_blank" rel="noopener noreferrer" class="badge">
          <span class="badge-title">Ingeniero de Software</span>
          <span class="badge-meta">Universitario ↗</span>
        </a>
        <a href="https://niiico.com/_astro/sistemas.36abc9c0.pdf" target="_blank" rel="noopener noreferrer" class="badge">
          <span class="badge-title">Técnico en Sistemas</span>
          <span class="badge-meta">SENA ↗</span>
        </a>
        <a href="https://niiico.com/_astro/scrum.b75839b4.pdf" target="_blank" rel="noopener noreferrer" class="badge">
          <span class="badge-title">SCRUM Fundamentals</span>
          <span class="badge-meta">Certificado ↗</span>
        </a>
        <a href="https://niiico.com/_astro/udw.4ab5ce98.pdf" target="_blank" rel="noopener noreferrer" class="badge">
          <span class="badge-title">Desarrollo Web</span>
          <span class="badge-meta">Udemy ↗</span>
        </a>
        <a href="https://niiico.com/_astro/pjs.ddccc43e.pdf" target="_blank" rel="noopener noreferrer" class="badge">
          <span class="badge-title">Profesional Javascript</span>
          <span class="badge-meta">Platzi ↗</span>
        </a>
        <a href="https://niiico.com/_astro/id.2f6d16cd.pdf" target="_blank" rel="noopener noreferrer" class="badge">
          <span class="badge-title">Inglés para Developers</span>
          <span class="badge-meta">Platzi ↗</span>
        </a>
      </div>

      <h2>Proyectos Destacados</h2>
      <div class="projects-grid">
        <a href="https://lacasadeloscolibris.com" target="_blank" rel="noopener noreferrer" class="project-card">
          <span class="tech-tag">Astro</span>
          <h3>La Casa de los Colibrís 🐦</h3>
          <p>Refugio de eventos, descanso y espiritualidad en Alocén, España. Diseño web con identidad de marca, galería multimedia y presencia digital completa.</p>
          <div class="project-links">
            <span>Visitar sitio →</span>
          </div>
        </a>
        <a href="https://spiny-few-tsunami.glitch.me" target="_blank" rel="noopener noreferrer" class="project-card">
          <span class="tech-tag">Socket.io • JavaScript</span>
          <h3>WebChat 💭</h3>
          <p>Aplicación de chat en tiempo real desplegada con éxito, mejorando los conceptos iniciales del curso.</p>
          <div class="project-links">
            <span>GitHub →</span>
          </div>
        </a>
        <a href="https://explounas2-nicolasarevalos-projects.vercel.app" target="_blank" rel="noopener noreferrer" class="project-card">
          <span class="tech-tag">HTML • CSS • JavaScript</span>
          <h3>Explouñas 💅🏼</h3>
          <p>Sitio web informativo hecho a medida para un emprendimiento. Diseño visualmente atractivo.</p>
          <div class="project-links">
            <span>GitHub →</span>
          </div>
        </a>
      </div>
    </div>
    
    <!-- Under Construction / Contact Alert -->
    <div id="prof-alert" class="newsletter-alert" style="display: none;">
      <span class="alert-icon">😉</span>
      <p>Pídemela por correo</p>
    </div>
  </div>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Select the certification badges
    const badges = document.querySelectorAll('.badge');
    const alert = document.getElementById('prof-alert');

    if (alert && badges.length > 0) {
      badges.forEach(badge => {
        badge.addEventListener('click', (e) => {
          e.preventDefault(); // Prevent navigating to the PDF
          
          // Ensure element is displayed before animating
          alert.style.display = 'flex';
          
          // Force reflow
          alert.offsetHeight; 
          
          // Show alert
          alert.classList.add('show-alert');
          
          // Hide after 3 seconds
          setTimeout(() => {
            alert.classList.remove('show-alert');
            
            setTimeout(() => {
              if(!alert.classList.contains('show-alert')) {
                alert.style.display = 'none';
              }
            }, 400); 
          }, 3000);
        });
      });
    }
  });
</script>

<style>
  .page-header {
    margin-bottom: 4rem;
  }

  .page-header h1 {
    font-size: 3.5rem;
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
    font-weight: 500;
    font-family: var(--font-heading);
  }

  .subtitle {
    font-size: 1.25rem;
    color: var(--text-secondary);
  }

  .prose :global(h2) {
    margin-top: 3rem;
    font-size: 2rem;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
    font-weight: 500;
    font-family: var(--font-heading);
  }

  .badges-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-bottom: 4.5rem;
  }

  .badge {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.6rem 1.1rem;
    background-color: #080808;
    border: 1px solid var(--border-color);
    border-radius: 50px; /* Pill shape */
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .badge:hover {
    border-color: rgba(147, 51, 234, 0.4);
    background-color: #0c0c0c;
  }

  .badge-title {
    color: var(--text-primary);
    font-size: 0.95rem;
    font-weight: 500;
    transition: color 0.2s ease, text-shadow 0.2s ease;
  }

  .badge-meta {
    color: var(--text-tertiary);
    font-size: 0.75rem;
    font-family: var(--font-body);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .badge:hover .badge-title {
    color: var(--accent-color);
    text-shadow: 0 0 10px rgba(147, 51, 234, 0.4);
  }

  .projects-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.5rem;
    isolation: isolate;
    background-color: #050505;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    overflow: hidden;
    text-decoration: none;
    transition: border-color 0.2s ease;
  }

  .project-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(147, 51, 234, 0.1) 0%, transparent 70%);
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: -1;
    pointer-events: none;
  }

  .project-card:hover {
    border-color: rgba(147, 51, 234, 0.3);
  }

  .project-card:hover::after {
    opacity: 1;
  }

  .tech-tag {
    display: inline-block;
    font-size: 0.75rem;
    color: #c084fc;
    font-family: var(--font-body);
    font-weight: 500;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }

  .project-card h3 {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    color: var(--text-primary);
    margin: 0 0 0.5rem;
    line-height: 1.2;
    font-weight: 500;
    transition: color 0.2s ease, text-shadow 0.2s ease;
  }

  .project-card:hover h3 {
    color: var(--accent-color);
    text-shadow: 0 0 10px rgba(147, 51, 234, 0.4);
  }

  .project-card p {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.5;
  }

  .project-links {
    margin-top: 1rem;
    font-size: 0.9rem;
    color: var(--text-tertiary);
  }

  /* Alert Toast Styles */
  .newsletter-alert {
    position: fixed;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%) translateY(100px);
    background-color: #000;
    border: 1px solid rgba(147, 51, 234, 0.4);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5), 0 0 20px rgba(147, 51, 234, 0.2);
    padding: 1rem 1.5rem;
    border-radius: 8px;
    align-items: center;
    gap: 0.75rem;
    opacity: 0;
    pointer-events: none;
    transition: all 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
    z-index: 9999;
  }

  .newsletter-alert.show-alert {
    transform: translateX(-50%) translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .alert-icon {
    font-size: 1.25rem;
  }

  .newsletter-alert p {
    margin: 0;
    color: var(--text-primary);
    font-size: 0.95rem;
    font-weight: 500;
  }

  @media (max-width: 500px) {
    .newsletter-alert {
      width: 90%;
      bottom: 1rem;
    }
  }
</style>
